    "        mmm, \n",
    "        label=f'Scenario {scen}', \n",
    "        color=colors[i],\n",
    "        lw=2\n",
    "    )\n",
    "    \n",
    "    # Plot the uncertainty range (±σ/2)\n",
    "    plt.fill_between(\n",
    "        year_range,\n",
    "        mmm - std,\n",
    "        mmm + std ,\n",
    "        alpha=0.3,\n",
